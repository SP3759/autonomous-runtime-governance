{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARG Telemetry Context Block",
  "description": "Captures session identifiers, cohort data, and geography for privacy jurisdiction evaluation",
  "type": "object",
  "required": ["session_id", "timestamp", "geography"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique identifier for this session",
      "format": "uuid"
    },
    "parent_session_id": {
      "type": ["string", "null"],
      "description": "Parent session ID for multi-turn lineage tracking",
      "format": "uuid"
    },
    "cohort_id": {
      "type": ["string", "null"],
      "description": "Learner or user cohort identifier for population-level drift analysis"
    },
    "geography": {
      "type": "object",
      "required": ["country_code"],
      "properties": {
        "country_code": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code",
          "pattern": "^[A-Z]{2}$"
        },
        "jurisdiction": {
          "type": "string",
          "description": "Regulatory jurisdiction identifier",
          "enum": ["EU", "US", "UK", "APAC", "OTHER"]
        }
      }
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of the event",
      "format": "date-time"
    },
    "application_id": {
      "type": "string",
      "description": "Identifier of the agent application"
    }
  }
}